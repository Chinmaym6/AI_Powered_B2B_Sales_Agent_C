# LangGraph Feature Flag
# Set to 'true' to enable LangGraph stateful workflow
# Set to 'false' to use standard agent (default)
USE_LANGGRAPH=true

# Gemini Model Selection
GEMINI_MODEL=gemini-2.0-flash

# Multi-Agent Collaborative System
# Set to 'true' for specialized agents (Researcher + Qualifier + Copywriter)
# Set to 'false' for single LangGraph agent
USE_MULTI_AGENT=true

# Multi-Agent Benefits:
# ✅ Researcher Agent - Deep company research
# ✅ Qualifier Agent - Lead scoring with detailed reasoning
# ✅ Copywriter Agent - Personalized email generation
# ✅ Better email quality and personalization
# ✅ More accurate lead qualification

# When you want to enable LangGraph:
# 1. Change the line above to: USE_LANGGRAPH=true
# 2. Restart the backend server
# 3. Create a new campaign - it will use LangGraph workflow

# LangGraph Benefits when enabled:
# ✅ State persistence - resume campaigns from checkpoints
# ✅ Parallel execution - 3-5x faster lead enrichment  
# ✅ Human approval - review leads before sending
# ✅ Smart routing - auto-skip low-scoring leads
# ✅ Error recovery - automatic retries

# To switch back:
# Simply set USE_LANGGRAPH=false and restart

# =============================================================================
# MULTI-AGENT PROCESSING LIMITS
# Adjust these to manage API quota usage (lower = fewer API calls)
# =============================================================================

# Max leads to research with AI (each lead = 1 API call)
MAX_LEADS_TO_RESEARCH=20

# Max leads to qualify with scoring (each lead = 1 API call)
MAX_LEADS_TO_QUALIFY=30

# Max emails to generate (each email = 1 API call)
MAX_EMAILS_TO_GENERATE=10

# Search results per query (higher = more leads found)
MAX_SEARCH_RESULTS=8

# TIP: If hitting Gemini quota limits (429 errors), reduce these values:
# - For testing: MAX_LEADS_TO_RESEARCH=5, MAX_EMAILS_TO_GENERATE=3
# - For production: Consider paid Gemini API tier

# =============================================================================
# HYBRID AI SYSTEM SETTINGS
# Use Groq (free fast API) for research, ML-only for qualification
# This reduces Gemini API calls from ~51 to ~11 per campaign!
# =============================================================================

# Groq Settings (Fast LLM API for Research - FREE!)
# Get your free API key: https://console.groq.com/keys
# FREE tier: 14,400 requests/day - faster than GPT-4!
GROQ_API_KEY=GROQ_API_KEY=

GROQ_MODEL=llama-3.1-8b-instant
GROQ_ENABLED=true

# Qualification Mode:
# - ml_only = Use ML + Semantic only (NO API calls - recommended)
# - ml_ai = Use ML + Semantic + Gemini AI (uses API)
# - ai_only = Use only Gemini AI (uses most API)
QUALIFICATION_MODE=ml_only

# API Call Comparison:
# ┌─────────────────┬──────────┬──────────────┐
# │ Phase           │ Before   │ After (Hybrid)│
# ├─────────────────┼──────────┼──────────────┤
# │ Product Analysis│ 1        │ 1 (Gemini)   │
# │ Research        │ 20       │ 0 (Groq)     │
# │ Qualification   │ 20       │ 0 (ML-only)  │
# │ Emails          │ 10       │ 10 (Gemini)  │
# │ TOTAL           │ 51       │ 11           │
# └─────────────────┴──────────┴──────────────┘
